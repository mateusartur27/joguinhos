---
import { env } from 'cloudflare:workers';
import AdSlot from '../components/AdSlot.astro';
import Base from '../layouts/Base.astro';
import { buscarJogos } from '../lib/db/jogos';

const jogos = await buscarJogos(env.DB);
---

<Base
  title="joguinhos — microjogos rápidos, sem cadastro"
  description="Escolhas impossíveis, rankings montados pelo público e quizzes rápidos. Um toque e você já está jogando."
>
  <main>
    <h1>Um parque de <b>microjogos</b>.</h1>
    <p class="lead">
      Um toque e você já está jogando. Sem cadastro, sem download.
    </p>

    {
      jogos.length === 0 ? (
        <p class="vazio">Nenhum jogo publicado ainda.</p>
      ) : (
        <ul class="catalogo">
          {jogos.map((jogo) => (
            <li>
              <a class="cartao" href={jogo.href} style={`--tom: ${jogo.cor};`}>
                <span class="emoji">{jogo.emoji}</span>
                <span class="conteudo">
                  <span class="titulo">{jogo.titulo}</span>
                  <span class="chamada">{jogo.chamada}</span>
                </span>
                <span class="seta">→</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <AdSlot slot="home-rodape" />

    <p class="rodape">
      Feito no Brasil. Os números que aparecem nos jogos vêm de quem jogou antes
      de você.
    </p>
  </main>
</Base>

<style>
  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2rem, 9vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  h1 b {
    background: linear-gradient(100deg, var(--a), var(--b) 60%, var(--c));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 30ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .vazio {
    padding: 3rem 0;
    color: var(--muted);
    text-align: center;
  }

  .catalogo {
    display: grid;
    gap: 0.7rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cartao {
    display: grid;
    grid-template-columns: 3rem 1fr 1.25rem;
    align-items: center;
    gap: 0.9rem;
    min-height: var(--tap);
    padding: 1.05rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--tom) 85%, black 12%);
    border-radius: var(--radius);
    background: var(--tom);
    box-shadow: 0 0.6rem 1.4rem -0.7rem color-mix(in srgb, var(--tom) 80%, black 15%);
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.2s ease;
  }

  .cartao:active {
    transform: scale(0.99);
  }

  .emoji {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.24);
    font-size: 1.5rem;
  }

  .conteudo {
    display: grid;
    gap: 0.15rem;
  }

  .titulo {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .chamada {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .seta {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    text-align: right;
  }

  .rodape {
    padding-top: 2.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }
</style>
