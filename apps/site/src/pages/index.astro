---
import { env } from 'cloudflare:workers';
import AdSlot from '../components/AdSlot.astro';
import Base from '../layouts/Base.astro';
import { buscarJogos } from '../lib/db/jogos';

const jogos = await buscarJogos(env.DB);

// Sem acento para "voce" encontrar "Você" — a mesma normalizacao roda nos
// dois lados (aqui no texto indexado, no script no que a pessoa digita).
const semAcento = (texto: string) => texto.normalize('NFD').replace(/[̀-ͯ]/g, '');
---

<Base
  title="joguinhos — microjogos rápidos, sem cadastro"
  description="Escolhas impossíveis, rankings montados pelo público e quizzes rápidos. Um toque e você já está jogando."
>
  <main>
    <h1>Um parque de <b>microjogos</b>.</h1>
    <p class="lead">
      Um toque e você já está jogando. Sem cadastro, sem download.
    </p>

    {
      jogos.length === 0 ? (
        <p class="vazio">Nenhum jogo publicado ainda.</p>
      ) : (
        <Fragment>
          <div class="busca">
            <span class="lupa" aria-hidden="true">
              🔎
            </span>
            <input
              type="search"
              id="busca-jogos"
              placeholder="Buscar jogo..."
              autocomplete="off"
              enterkeyhint="search"
            />
          </div>

          <ul class="catalogo" data-catalogo>
            {jogos.map((jogo) => (
              <li data-item data-busca={semAcento(`${jogo.titulo} ${jogo.chamada}`).toLowerCase()}>
                <a class="cartao" href={jogo.href} style={`--tom: ${jogo.cor};`}>
                  <span class="emoji">{jogo.emoji}</span>
                  <span class="conteudo">
                    <span class="titulo">{jogo.titulo}</span>
                    <span class="chamada">{jogo.chamada}</span>
                  </span>
                  <span class="seta">→</span>
                </a>
              </li>
            ))}
          </ul>

          <p class="vazio" data-sem-resultado hidden>
            Nenhum jogo encontrado.
          </p>
        </Fragment>
      )
    }

    <AdSlot slot="home-rodape" />

    <p class="rodape">
      Feito no Brasil. Os números que aparecem nos jogos vêm de quem jogou antes
      de você.
    </p>
  </main>
</Base>

<script>
  const campo = document.querySelector<HTMLInputElement>('#busca-jogos');
  const itens = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const semResultado = document.querySelector<HTMLElement>('[data-sem-resultado]');
  if (!campo) {
    // Sem jogo publicado, a busca nem existe no HTML — nada a fazer.
  } else {
    campo.addEventListener('input', () => {
      const termo = campo.value
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .trim();

      let visiveis = 0;
      for (const item of itens) {
        const bate = (item.dataset.busca ?? '').includes(termo);
        item.hidden = !bate;
        if (bate) visiveis += 1;
      }
      if (semResultado) semResultado.hidden = visiveis > 0;
    });
  }
</script>

<style>
  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2rem, 9vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  h1 b {
    background: linear-gradient(100deg, var(--a), var(--b) 60%, var(--c));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 30ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .vazio {
    padding: 3rem 0;
    color: var(--muted);
    text-align: center;
  }

  .busca {
    position: relative;
    margin-top: 1.75rem;
  }

  .lupa {
    position: absolute;
    top: 50%;
    left: 1rem;
    font-size: 1rem;
    opacity: 0.6;
    transform: translateY(-50%);
  }

  #busca-jogos {
    width: 100%;
    min-height: var(--tap);
    padding: 0 1rem 0 2.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    -webkit-appearance: none;
    appearance: none;
  }

  #busca-jogos::placeholder {
    color: var(--muted);
  }

  /* Remove o "x" nativo do input search no Chrome/Safari — o feedback de
     "sem resultado" ja cobre o caso de busca vazia. */
  #busca-jogos::-webkit-search-cancel-button {
    display: none;
  }

  #busca-jogos:focus-visible {
    outline: 2px solid var(--b);
    outline-offset: 1px;
  }

  .catalogo {
    display: grid;
    gap: 0.7rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cartao {
    display: grid;
    grid-template-columns: 3rem 1fr 1.25rem;
    align-items: center;
    gap: 0.9rem;
    min-height: var(--tap);
    padding: 1.05rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--tom) 85%, black 12%);
    border-radius: var(--radius);
    background: var(--tom);
    box-shadow: 0 0.6rem 1.4rem -0.7rem color-mix(in srgb, var(--tom) 80%, black 15%);
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.2s ease;
  }

  .cartao:active {
    transform: scale(0.99);
  }

  .emoji {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.24);
    font-size: 1.5rem;
  }

  .conteudo {
    display: grid;
    gap: 0.15rem;
  }

  .titulo {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .chamada {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .seta {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    text-align: right;
  }

  .rodape {
    padding-top: 2.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }
</style>
